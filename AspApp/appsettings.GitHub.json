{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "AspApp.Controllers.AuthenticationController": "Information"
    }
  },

  "AllowedHosts": "*",

  "Kafka": {
    "BootstrapServer": "kafka:9092",
    "LogTopic": "log",
    "EmailTopic": "email"
  },

  "Postgres": {
    "ConnectionString": {
      "Identity": "Host=postgres;Database=IdentityDb;Username=postgres;Password=Password;",
      "DataProtection": "Host=postgres;Database=DataProtectionDb;Username=postgres;Password=Password;"
    }
  },

  "MongoDb": {
    "ConnectionString": "mongodb://mongodb:27017",
    "UserDbName": "Users_Db",
    "ProfileCollectionName": "Profile"
  },

  "Identity":{
    "AdminPassword": "YourAdminPassWord"
  },

  "GitHubClientId": "YourClientId",
  "GitHubClientSecret": "YourClientSecret",
  
  "GoogleClientId": "yourClientId.apps.googleusercontent.com",
  "GoogleClientSecret": "Your-Client-Secret",

  "Turnstile": {
    "Enabled": false,
    "SecretKey": "your-secret-key"
  }
}
